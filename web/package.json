{
  "name": "runner-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "scripts/deploy-local.sh",
    "notify": "node scripts/push.mjs",
    "publish:updates": "node scripts/publish-updates.mjs --deploy",
    "faces:index": "node -e \"const fs=require('fs');const d='public/faces';if(fs.existsSync(d))fs.writeFileSync(d+'/index.json',JSON.stringify(fs.readdirSync(d).filter(n=>/\\.(png|jpe?g|webp)$/i.test(n))))\""
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-push": "3.6.7"
  }
}
